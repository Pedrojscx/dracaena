#!/usr/bin/env bash
# Mock do ydotool 1.0.x. MOCK_YDOTOOL: ok | noconnect | syntax.
# Registra a chamada (com o socket usado) em $MOCK_DIR/calls.log.
echo "ydotool $* [socket=${YDOTOOL_SOCKET:-}]" >> "$MOCK_DIR/calls.log"
case "${MOCK_YDOTOOL:-ok}" in
    noconnect)
        echo "failed to connect socket \`${YDOTOOL_SOCKET:-/tmp/.ydotool_socket}': Connection refused" >&2
        echo "Please check if ydotoold is running." >&2
        exit 2 ;;
    syntax)
        echo "ydotool: Unknown command: $1" >&2
        echo "Run 'ydotool help' if you want a command list" >&2
        exit 1 ;;
esac
if [[ "$1" == mousemove ]]; then
    [[ "$*" == "mousemove --wheel -x 0 -y "* ]] || { echo "mousemove: invalid option" >&2; exit 1; }
fi
exit 0
