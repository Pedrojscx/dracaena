#!/usr/bin/env bash
# Diagnóstico DOM/CDP somente leitura; não clica nem consulta questões ao Claude.
# quiz-doctor env: diagnóstico opcional que consulta exemplos sintéticos ao Claude.
set -uo pipefail
QH_REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/sh/common.sh
source "$QH_REPO/lib/sh/common.sh"
case "${1:-}" in
    -h|--help)
        echo 'quiz-doctor: verifica instalação DOM/CDP sem clicar ou consultar o Claude.'
        echo 'quiz-doctor env: compara consultas sintéticas terminal/Hyprland (consome cota).'
        echo 'OCR, grim, slurp e ydotool pertencem ao legado em lib/sh/doctor-legacy.sh.'
        exit 0 ;;
    env) shift; action=envcheck ;;
    '') action=doctor ;;
    *) echo 'opção inválida; use quiz-doctor --help' >&2; exit 2 ;;
esac
[[ -x "$QH_PYTHON" ]] || { echo '[FALHA] Python do venv ausente; execute ./install.sh' >&2; exit 1; }
export PYTHONPATH="$QH_REPO/lib${PYTHONPATH:+:$PYTHONPATH}"
exec "$QH_PYTHON" -m quizhelper "$action" "$@"
