#!/usr/bin/env bash
# quiz-loop (SUPER+P): responde sozinho as questões da aba do NetAcad aberta
# no Vivaldi do quiz-helper (quiz-browser), via Chrome DevTools Protocol.
#
#   quiz-loop             nenhum loop rodando: inicia
#                         rodando: pausa;  pausado: retoma (SIGUSR1)
#   quiz-loop --stop      para (se estiver rodando)
#   quiz-loop --status    mostra se está rodando
#   quiz-loop --dry-run   lê e consulta o Claude, mas a guarda não clica
#   quiz-loop --once      responde só a questão atual
#
# Os cliques via CDP não movem o cursor: dá para usar o computador enquanto
# o loop roda. O envio final da avaliação permanece manual.
set -uo pipefail

QH_REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/sh/common.sh
source "$QH_REPO/lib/sh/common.sh"
# shellcheck source=../lib/sh/notify.sh
source "$QH_REPO/lib/sh/notify.sh"

usage() { sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

ACTION=toggle
ARGS=()
while (( $# )); do
    case "$1" in
        --stop) ACTION=stop ;;
        --status) ACTION=status ;;
        --dry-run|--once) ARGS+=("$1") ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac
    shift
done

mkdir -p "$QH_RUNTIME_DIR"
PIDFILE="$QH_RUNTIME_DIR/loop.pid"
LOCKFILE="$QH_RUNTIME_DIR/loop.lock"

# Pid do loop em execução (o bash antes do exec ou o Python depois dele).
running_pid() {
    local pid cmd
    [[ -r "$PIDFILE" ]] || return 1
    pid="$(< "$PIDFILE")"
    [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2> /dev/null || return 1
    cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2> /dev/null)"
    [[ "$cmd" == *"quizhelper loop"* || "$cmd" == *quiz-loop* ]] || return 1
    printf '%s\n' "$pid"
}

# A trava vale só durante a decisão (iniciar ou sinalizar). Ela é liberada
# antes de iniciar qualquer processo, então nenhum filho (wl-copy, claude...)
# a herda e a deixa presa depois que o loop termina.
exec 9> "$LOCKFILE"
if ! flock -w 3 9; then
    qh_notify "quiz-helper" "Outro quiz-loop está iniciando; tente de novo." normal 3000
    exit 1
fi
if pid="$(running_pid)"; then
    case "$ACTION" in
        status) echo "rodando (pid $pid)"; exit 0 ;;
        stop) kill -TERM "$pid"; exit 0 ;;
        *) kill -USR1 "$pid"; exit 0 ;;   # pausa ou retoma: o loop decide
    esac
fi
case "$ACTION" in
    stop) exit 0 ;;
    status) echo "parado"; exit 0 ;;
esac

[[ -x "$QH_PYTHON" ]] || { qh_notify "quiz-helper" "Python do venv ausente ($QH_PYTHON); rode install.sh" critical 8000; exit 1; }
# Um SIGUSR1 que chegue entre gravar o pid e o exec é ignorado (sem matar o bash).
trap '' USR1
printf '%s\n' "$$" > "$PIDFILE"
exec 9>&-

qh_read_kv "$QH_DEFAULT_CONFIG"
qh_read_kv "$QH_USER_CONFIG"
if [[ -d "$QH_DATA_DIR/runs" ]]; then
    find "$QH_DATA_DIR/runs" -mindepth 1 -maxdepth 1 -type d -mtime +"${CFG_KEEP_DAYS:-7}" -exec rm -rf {} + 2> /dev/null
fi

export PYTHONPATH="$QH_REPO/lib${PYTHONPATH:+:$PYTHONPATH}"
exec "$QH_PYTHON" -m quizhelper loop "${ARGS[@]}"
