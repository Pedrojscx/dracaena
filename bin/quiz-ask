#!/usr/bin/env bash
# quiz-ask (SUPER+SHIFT+P): responde a questão atual da aba do NetAcad (lida
# do DOM via CDP) e só NOTIFICA a resposta, copiando-a para a área de
# transferência. Não clica em nada.
set -uo pipefail

QH_REPO="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../lib/sh/common.sh
source "$QH_REPO/lib/sh/common.sh"
# shellcheck source=../lib/sh/notify.sh
source "$QH_REPO/lib/sh/notify.sh"

case "${1:-}" in
    -h|--help) sed -n '2,4p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac

mkdir -p "$QH_RUNTIME_DIR"
# Uma consulta por vez. O Python fecha os descritores herdados nos processos
# que inicia (claude, wl-copy), então a trava some quando ele termina.
exec 9> "$QH_RUNTIME_DIR/ask.lock"
flock -n 9 || exit 0

[[ -x "$QH_PYTHON" ]] || { qh_notify "quiz-ask" "Python do venv ausente ($QH_PYTHON); rode install.sh" critical 8000; exit 1; }
export PYTHONPATH="$QH_REPO/lib${PYTHONPATH:+:$PYTHONPATH}"
exec "$QH_PYTHON" -m quizhelper ask
